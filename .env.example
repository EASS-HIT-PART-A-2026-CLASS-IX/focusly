# Copy this file to .env and fill in the values.
#   cp .env.example .env

# Required — get a key at https://aistudio.google.com
GOOGLE_API_KEY=

# Optional — Gemma model used by the AI service
GEMMA_MODEL=gemma-4-31b-it

# Optional — Postgres password (defaults to "focusly" if unset)
POSTGRES_PASSWORD=focusly

# Optional — JWT signing secret (defaults to "change-me-in-production" if unset)
SECRET_KEY=change-me-in-production

# Optional — seconds between overdue-task worker runs (defaults to 30 if unset)
WORKER_INTERVAL=30
